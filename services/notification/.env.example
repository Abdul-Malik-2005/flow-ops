# --- Database ---
DATABASE_URL=postgresql+asyncpg://notification_user:dev_password@localhost:5435/notification_db
# Used only by `tests/integration`. The name must end with `_test_db`:
# those tests truncate tables and the guard refuses anything else.
TEST_DATABASE_URL=postgresql+asyncpg://notification_user:dev_password@localhost:5435/notification_test_db

# --- App ---
DEBUG=false
ENVIRONMENT=development

# --- Event consumer (`python -m app.event_consumer`) ---
# Notification is a pure consumer: it subscribes to the exchange owned by Order
# and records every delivered fact in its own inbox. It never publishes.
RABBITMQ_URL=amqp://flowops:dev_password@localhost:5672/
# The exchange is owned by its producer (Order); a consumer only reads it and
# never declares it with different arguments.
ORDER_EVENTS_EXCHANGE=order.events
# The queue belongs to this consumer, not to Order. Order declares only the
# exchange, so a new consumer appears without a deploy of the producer.
EVENT_CONSUMER_QUEUE=notification.order-events
# Notification's own dead-letter topology, separate from Order's: dead letters
# from this queue must not leak into another service's DLQ.
EVENT_CONSUMER_DLX_EXCHANGE=notification.order-events.dlx
EVENT_CONSUMER_DLQ=notification.order-events.dlq
# Unacknowledged messages the broker may push at once.
EVENT_CONSUMER_PREFETCH_COUNT=10
# Deliveries accepted before the consumer refuses the message without requeue
# (dead letter). The counter is the broker's `x-acquired-count`: RabbitMQ 4 does
# not apply `x-delivery-limit` to an explicit requeue, so the runtime checks the
# header. Deterministic refusals are dead-lettered on the first delivery.
EVENT_CONSUMER_MAX_DELIVERY_COUNT=5
# How often the consumer logs a one-line report (received/duplicates/retried/
# refused/dead_lettered). Per-event lines stay at DEBUG.
EVENT_CONSUMER_REPORT_INTERVAL_SECONDS=60.0
# Interruptible pause after a transient failure; without it a database outage
# turns requeue into a hot loop that burns the delivery budget.
EVENT_CONSUMER_REQUEUE_DELAY_SECONDS=2.0
EVENT_CONSUMER_RECONNECT_DELAY_SECONDS=5.0

# --- Notification sender (`python -m app.sender`) ---
# Reads recorded inbox rows and delivers each once, then marks `sent_at`. No
# broker: this process only reads and updates its own database. Delivery is
# at-least-once, with `event_id` as the idempotency key handed to the provider.
SENDER_INTERVAL_SECONDS=5.0
# Rows claimed per pass; the claim is one `UPDATE ... FOR UPDATE SKIP LOCKED`.
SENDER_BATCH_SIZE=50
# Lease on a claimed row. Must be >= 2 * SENDER_INTERVAL_SECONDS: a pass has to
# finish before its own lease expires, otherwise a second sender reclaims rows
# that are still in flight. Doubles as the backoff after a failed send.
SENDER_LEASE_SECONDS=30.0
# Send attempts per notification; then the row leaves the feed and is logged as
# an error. It is never deleted: a missed notification stays repairable.
SENDER_MAX_ATTEMPTS=10
# Which transport the sender builds: `log` (one JSON line; needs no infrastructure)
# or `smtp` (real email; dev delivers into Mailpit at http://127.0.0.1:8025).
SENDER_TRANSPORT=log
# Read only when SENDER_TRANSPORT=smtp. Dev points them at Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=orders@flowops.local
SMTP_TIMEOUT_SECONDS=10.0
SMTP_USE_TLS=false
# Dev recipient domain: a `user_id` becomes `<user_id>@<domain>`. The real
# resolver will call Identity once it exposes a lookup.
RECIPIENT_DOMAIN=flowops.local


