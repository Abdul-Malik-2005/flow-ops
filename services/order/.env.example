# --- Database ---
DATABASE_URL=postgresql+asyncpg://order_user:dev_password@localhost:5434/order_db
# Used only by `tests/integration`. The name must end with `_test_db`:
# those tests truncate tables and the guard refuses anything else.
TEST_DATABASE_URL=postgresql+asyncpg://order_user:dev_password@localhost:5434/order_test_db

# --- App ---
DEBUG=false
ENVIRONMENT=development

# --- Auth ---
# Order only verifies access tokens issued by Identity, so it needs the public
# key and the `kid` it expects — never the private key.
JWT_ALGORITHM=RS256
JWT_KID=identity-1
JWT_PUBLIC_KEY_PATH=../identity/keys/jwt_public.pem

# --- Inter-service calls (Order -> Inventory) ---
INVENTORY_BASE_URL=http://localhost:8000
SERVICE_TOKEN=local-dev-service-token
INVENTORY_TIMEOUT_SECONDS=5.0
# Lease on the reserve step: cancellation stays blocked while a reserve call
# may still be in flight. Must be >= 2 * INVENTORY_TIMEOUT_SECONDS.
RESERVATION_STALE_AFTER_SECONDS=30.0

# --- Reconciler (`python -m app.worker`) ---
# Shares the lease above: an expired lease means the reserve call was lost, so
# the worker re-drives it. Both processes must see the SAME
# RESERVATION_STALE_AFTER_SECONDS, otherwise they collide on one order.
RECONCILE_INTERVAL_SECONDS=30.0
RECONCILE_BATCH_SIZE=20
# Attempts budget per order; when it runs out the order fails as
# `reservation_unavailable` instead of being retried forever.
RESERVATION_MAX_ATTEMPTS=20
# Error-log threshold for orders that are still `pending` (never changes
# state). Must be >= RESERVATION_STALE_AFTER_SECONDS.
PENDING_ALERT_AFTER_SECONDS=900.0

# --- Outbox relay (`python -m app.outbox_relay`) ---
# A separate process that publishes the events already committed to
# `outbox_events`. It never holds a transaction across the publish call: claim
# and mark are two short transactions, the transport sits between them, so a
# crash in the middle is safe by design (at-least-once, dedupe by `event_id`).
# All relay replicas must use the SAME values: a different lease makes one
# replica act on a row another still considers "being published".
OUTBOX_RELAY_INTERVAL_SECONDS=5.0
# Rows claimed per pass. The claim is one `UPDATE ... FOR UPDATE SKIP LOCKED`,
# so a bigger batch is cheaper per event but holds the row lock longer.
OUTBOX_BATCH_SIZE=50
# Lease on a claimed row: `locked_at` older than this means the publisher never
# came back, so the row is claimable again. The lease doubles as the backoff,
# because a failed publish writes nothing at all. Must be >= 2 *
# OUTBOX_RELAY_INTERVAL_SECONDS: a pass has to finish before its own lease
# expires, otherwise a second relay reclaims rows that are still in flight.
OUTBOX_LEASE_SECONDS=30.0
# Publish attempts per event; after this the row leaves the claim predicate and
# is reported as an error log. It is never deleted: a missed event must stay
# repairable by hand.
OUTBOX_MAX_ATTEMPTS=10

# --- Event transport (`python -m app.outbox_relay`) ---
# The transport is a port (`EventPublisherPort`), not a property of the relay:
# claim, publish and mark work the same, only the adapter changes.
# `log`  — one JSON line per event on stdout (default; needs no infrastructure);
# `rabbitmq` — publish to OUTBOX_EXCHANGE and wait for a broker confirmation.
# `rabbitmq` — the deployed setting: the consumer service binds a queue to
# OUTBOX_EXCHANGE, so every event has a destination. `log` is for running the
# relay without infrastructure (a local `--once`, a smoke test) and stays the
# code default for the same reason.
OUTBOX_PUBLISHER=rabbitmq
# Read only when OUTBOX_PUBLISHER=rabbitmq. Use `guest` only against a local
# broker: it is loopback-only by design and refuses remote connections.
RABBITMQ_URL=amqp://flowops:dev_password@localhost:5672/
# One exchange per producer service: `order` owns its event stream, so it can add
# a type or retire the exchange without touching anyone else's routing. Durable
# topic exchange; the routing key is the event type (`order.reserved`), which
# lets a consumer subscribe to one fact (`order.reserved`) or to all of them
# (`order.#`) without asking the producer to change anything.
OUTBOX_EXCHANGE=order.events

# --- Event consumer (`python -m app.event_consumer`) ---
# Read-only journal of delivered events: it records that a message was processed
# and never writes to `orders`/`outbox_events` or publishes anything. The queue
# belongs to its consumer: the producer declares only the exchange. Requires
# RABBITMQ_URL (above).
EVENT_CONSUMER_QUEUE=order.event-projections
EVENT_CONSUMER_DLX_EXCHANGE=order.events.dlx
EVENT_CONSUMER_DLQ=order.event-projections.dlq
# Unacknowledged messages the broker may push at once.
EVENT_CONSUMER_PREFETCH_COUNT=10
# Deliveries accepted before the consumer refuses the message without requeue
# (dead letter). The counter is the broker's `x-acquired-count`: RabbitMQ 4 does
# not apply `x-delivery-limit` to an explicit requeue, so the runtime checks the
# header. Deterministic refusals are dead-lettered on the first delivery.
EVENT_CONSUMER_MAX_DELIVERY_COUNT=5
# How often the consumer logs a one-line report (processed/duplicates/retried/
# refused/dead_lettered). Per-event lines stay at DEBUG.
EVENT_CONSUMER_REPORT_INTERVAL_SECONDS=60.0
# Interruptible pause after a transient failure; without it a database outage
# turns requeue into a hot loop that burns the delivery budget.
EVENT_CONSUMER_REQUEUE_DELAY_SECONDS=2.0
EVENT_CONSUMER_RECONNECT_DELAY_SECONDS=5.0

# --- Orders ---
# Currency is stored from day one; amounts stay NULL until Catalog provides
# prices (see `PricingPort` in docs/architecture.md).
DEFAULT_CURRENCY=RUB
