# --- Database ---
DATABASE_URL=postgresql+asyncpg://identity_user:dev_password@localhost:5433/identity_db
TEST_DATABASE_URL=

# --- App ---
DEBUG=false
ENVIRONMENT=development

# --- JWT (используется начиная с Шага 3) ---
JWT_ALGORITHM=RS256
JWT_KID=identity-1
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000